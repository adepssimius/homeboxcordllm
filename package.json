{
  "name": "homeboxcordllm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/main.js",
    "dev": "node --watch --enable-source-maps dist/main.js",
    "chat": "node --enable-source-maps dist/chat.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "image": "discordllm-build"
  },
  "dependencies": {
    "discordllm": "https://github.com/adepssimius/discordLLM/releases/download/v0.2.0/discordllm-0.2.0.tgz",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "pino-pretty": "^13.0.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  },
  "discordllm": {
    "uvTools": [
      "homebox-mcp==1.5.1"
    ],
    "uvPython": "3.13",
    "smoke": "HOMEBOX_TOKEN=x /opt/uv/tools/homebox-mcp/bin/python -c 'import homebox_mcp, pillow_heif'"
  }
}
